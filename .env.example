PORT=3001
APP_URL=http://localhost:3001
DATA_DIR=.data
DEMO_MODE=false
# Local AI needs no provider subscription. Customers may optionally save encrypted external keys in their AI settings.
LOCAL_AI_URL=http://127.0.0.1:8081/v1
LOCAL_SPEECH_URL=http://127.0.0.1:8082
LOCAL_IMAGE_URL=http://127.0.0.1:8083
LOCAL_PORTRAIT_URL=http://127.0.0.1:8084
# Bootstrap a NEW admin only; or register then use npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional text persistence; Atlas needs a real native TLS connection string.
MONGODB_URI=
MONGODB_DB=benai
# Optional private Cloudflare R2 video storage.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional customer payments (not required to run AI models).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Production: APP_URL=https://your-domain; NODE_ENV=production.
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.
# V3: optional separate CUDA portrait worker; checked before GPU mode is enabled.
GPU_PORTRAIT_URL=
# Production encryption key: securely generate 32 random bytes, base64 encoded.
# Keep the same key across restarts/backups; losing it loses access to customer keys.
# Development auto-creates a private .data/.provider-master-key instead.
BYOK_MASTER_KEY=
# Production requires real SMTP delivery, MAIL_FROM and TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production enforces verification automatically. Enable for a private deployment too.
REQUIRE_VERIFIED_EMAIL=false
# Optional additional VERIFIED HeyGen media hostnames, comma-separated; never customer-controlled.
HEYGEN_MEDIA_HOSTS=

PORT=3001
APP_URL=http://localhost:3001
DATA_DIR=.data
DEMO_MODE=false
# All AI services are self-hosted. No OpenAI/HeyGen subscription or API key.
LOCAL_AI_URL=http://127.0.0.1:8081/v1
LOCAL_SPEECH_URL=http://127.0.0.1:8082
LOCAL_IMAGE_URL=http://127.0.0.1:8083
LOCAL_PORTRAIT_URL=http://127.0.0.1:8084
# Bootstrap a NEW admin only; or register then use npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional text persistence; Atlas needs a real native TLS connection string.
MONGODB_URI=
MONGODB_DB=benai
# Optional private Cloudflare R2 video storage.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional customer payments (not required to run AI models).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Production: APP_URL=https://your-domain; NODE_ENV=production.
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.

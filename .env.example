PORT=3001
APP_URL=http://localhost:3001
DATA_DIR=.data
DEMO_MODE=true
# Set these before starting to create the first administrator; no default admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# OpenAI key may be provided as AI_PROVIDER_KEY (cloud proxy compatible) or OPENAI_API_KEY.
AI_PROVIDER_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1
AI_REALTIME_MODEL=gpt-realtime
HEYGEN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Production: APP_URL must be your HTTPS origin, NODE_ENV=production, DEMO_MODE=false.

# Free local services: run npm run setup:local and npm run services:local
LOCAL_AI_URL=http://127.0.0.1:8081/v1
LOCAL_SPEECH_URL=http://127.0.0.1:8082
# Optional AUTOMATIC1111-compatible image server (you supply model/hardware)
LOCAL_IMAGE_URL=http://127.0.0.1:8083
# Native MongoDB connection (raw server credentials, never a proxy placeholder)
MONGODB_URI=
MONGODB_DB=benai
# Cloudflare R2 S3 API: private bucket; downloads use expiring signed URLs.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
HEYGEN_VOICE_ID=
